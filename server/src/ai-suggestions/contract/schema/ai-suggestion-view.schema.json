{
  "$defs": {
    "AvailableSuggestionView": {
      "additionalProperties": false,
      "description": "A suggestion the assessor can see.\n\nScored fields (Impact Areas, IRL, IUL): ``signal`` green/amber/red, ``valueKind`` \"level\",\n``suggestedValue`` the level, ``evidenceQuote`` the supporting passage.\n\nIndicative fields: ``signal`` \"indicative\" (no colour), no ``evidenceQuote`` (prompts 06 and 09 are\nused verbatim and ask the model not to quote), and ``suggestedValue`` always present:\n  - ``general.result_type``: ``valueKind`` \"category\", one of ResultCategory (\"Innovation\" or the\n    alternative category prompt 06 predicts);\n  - ``innovation_use.current_use.actors``: ``valueKind`` \"use_numbers\", the list of user groups of\n    prompt 09 (``user`` \"actors\" | \"organizations\" | \"other type\" -> the catalog lists actors,\n    organizations and measures; ``user_type``/``user_subtype`` the actor or institution type; the\n    quantity and sex/age disaggregation). An empty list means the evidence reports no use numbers.\n    ``coversFieldKeys`` lists organizations and measures: the chip says it covers actors,\n    organizations and measures.",
      "properties": {
        "copiedByReviewer": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copiedbyreviewer"
        },
        "coversFieldKeys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when one suggestion covers several catalog fields. Innovation use numbers is stored under\n``innovation_use.current_use.actors`` and covers actors, organizations and measures.",
          "title": "Coversfieldkeys"
        },
        "editedByReviewer": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Editedbyreviewer"
        },
        "evidenceQuote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For IRL/IUL always non-empty and found verbatim in the evidence (else the field is unavailable).\nIndicative fields have none: their prompts (06, 09) ask the model not to quote.",
          "title": "Evidencequote"
        },
        "evidenceSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidencesource"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "fieldKey": {
          "title": "Fieldkey",
          "type": "string"
        },
        "modelId": {
          "title": "Modelid",
          "type": "string"
        },
        "promptVersion": {
          "title": "Promptversion",
          "type": "string"
        },
        "quoteVerified": {
          "title": "Quoteverified",
          "type": "boolean"
        },
        "signal": {
          "description": "``indicative`` exactly when the field is indicative (result category, innovation use numbers).",
          "enum": [
            "green",
            "amber",
            "red",
            "indicative"
          ],
          "title": "Signal",
          "type": "string"
        },
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "suggestedValue": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "Innovation",
                "Knowledge Product",
                "Capacity Sharing for Development",
                "Routine Activity",
                "Other"
              ],
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/UseNumberRow"
              },
              "type": "array"
            }
          ],
          "description": "level: on the field's scale, Impact Areas 0-2, IRL/IUL 0-9 (level number, not a catalog id).",
          "title": "Suggestedvalue"
        },
        "suggestionId": {
          "title": "Suggestionid",
          "type": "string"
        },
        "valueKind": {
          "enum": [
            "level",
            "category",
            "use_numbers"
          ],
          "title": "Valuekind",
          "type": "string"
        }
      },
      "required": [
        "status",
        "fieldKey",
        "suggestionId",
        "signal",
        "valueKind",
        "suggestedValue",
        "explanation",
        "quoteVerified",
        "evidenceSource",
        "promptVersion",
        "modelId"
      ],
      "title": "AvailableSuggestionView",
      "type": "object"
    },
    "PendingSuggestionView": {
      "additionalProperties": false,
      "properties": {
        "fieldKey": {
          "title": "Fieldkey",
          "type": "string"
        },
        "status": {
          "const": "pending",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "fieldKey"
      ],
      "title": "PendingSuggestionView",
      "type": "object"
    },
    "UnavailableSuggestionView": {
      "additionalProperties": false,
      "properties": {
        "fieldKey": {
          "title": "Fieldkey",
          "type": "string"
        },
        "status": {
          "const": "unavailable",
          "title": "Status",
          "type": "string"
        },
        "unavailableReason": {
          "enum": [
            "no_readable_evidence",
            "private_link",
            "model_declined",
            "invalid_output",
            "no_criteria_for_field",
            "no_supporting_quote",
            "out_of_scope_funding",
            "failed"
          ],
          "title": "Unavailablereason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "fieldKey",
        "unavailableReason"
      ],
      "title": "UnavailableSuggestionView",
      "type": "object"
    },
    "UseNumberRow": {
      "additionalProperties": false,
      "description": "One user group of prompt 09 (Innovation Use Numbers v3), keys exactly as the prompt returns them.",
      "properties": {
        "geolocation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Geolocation"
        },
        "men": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Men"
        },
        "non_youth_men": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Non Youth Men"
        },
        "non_youth_women": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Non Youth Women"
        },
        "other_quantitative_measures": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Other Quantitative Measures"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Quantity"
        },
        "user": {
          "title": "User",
          "type": "string"
        },
        "user_subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Subtype"
        },
        "user_type": {
          "title": "User Type",
          "type": "string"
        },
        "women": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Women"
        },
        "youth_men": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Youth Men"
        },
        "youth_women": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Youth Women"
        }
      },
      "required": [
        "user",
        "user_type",
        "user_subtype",
        "quantity",
        "women",
        "youth_women",
        "non_youth_women",
        "men",
        "youth_men",
        "non_youth_men",
        "geolocation",
        "other_quantitative_measures"
      ],
      "title": "UseNumberRow",
      "type": "object"
    }
  },
  "$id": "ai-suggestion-view.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "available": "#/$defs/AvailableSuggestionView",
      "pending": "#/$defs/PendingSuggestionView",
      "unavailable": "#/$defs/UnavailableSuggestionView"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AvailableSuggestionView"
    },
    {
      "$ref": "#/$defs/UnavailableSuggestionView"
    },
    {
      "$ref": "#/$defs/PendingSuggestionView"
    }
  ],
  "x-contractVersion": "2.0.0"
}
