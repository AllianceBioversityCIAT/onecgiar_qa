PORT=3000

# MySQL (Drizzle)
DATABASE_URL=mysql://user:password@localhost:3306/onecgiar_qa
DATABASE_POOL_SIZE=10

# DynamoDB (ElectroDB)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=onecgiar-qa
# Only for DynamoDB Local; leave unset to use AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Auth (Cognito-native session)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=
# App client secret: set it in your local .env only, never here.
COGNITO_CLIENT_SECRET=
# Hosted UI domain, e.g. https://<domain>.auth.us-east-1.amazoncognito.com
COGNITO_URL=
# Optional: user-pool API endpoint; defaults to https://cognito-idp.<COGNITO_REGION>.amazonaws.com/
# COGNITO_USER_POOL_URL=
# Comma-separated exact origins. https:// only, except http://localhost:<port>.
ALLOWED_ORIGINS=http://localhost:4200
# Optional: email of the first ADMIN created by the seed.
# SEED_ADMIN_EMAIL=
