PORT=3000

# MySQL (Drizzle)
DATABASE_URL=mysql://user:password@localhost:3306/onecgiar_qa
DATABASE_POOL_SIZE=10

# DynamoDB (ElectroDB)
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=onecgiar-qa
# Only for DynamoDB Local; leave unset to use AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000
# Local development only, both or neither (TEST/PROD use the host's IAM role).
# Set them in your local .env; never put real values here.
# DYNAMODB_ACCESS_KEY_ID=
# DYNAMODB_SECRET_ACCESS_KEY=

# Auth (Cognito-native session)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=
# App client secret: set it in your local .env only, never here.
COGNITO_CLIENT_SECRET=
# Hosted UI domain, e.g. https://<domain>.auth.us-east-1.amazoncognito.com
COGNITO_URL=
# Admin API (user management), local development only, both or neither. Used
# with COGNITO_REGION and COGNITO_USER_POOL_ID; TEST/PROD use the host's IAM role.
# Set them in your local .env; never put real values here.
# COGNITO_ADMIN_ACCESS_KEY_ID=
# COGNITO_ADMIN_SECRET_ACCESS_KEY=
# Optional: user-pool API endpoint; defaults to https://cognito-idp.<COGNITO_REGION>.amazonaws.com/
# COGNITO_USER_POOL_URL=
# Comma-separated exact origins. https:// only, except http://localhost:<port>.
ALLOWED_ORIGINS=http://localhost:4200
# API docs (Swagger UI at /api/v1/docs). Default: on unless NODE_ENV=production.
# OPENAPI_ENABLED=true
# Optional: email of the first ADMIN created by the seed.
# SEED_ADMIN_EMAIL=

# Catalog sources (https:// only). Base URLs, with the /api path.
REPORTING_API_URL=
CLARISA_API_URL=
# Secret, shared by CLARISA and Reporting: set it in your local .env only, never here.
CLARISA_API_KEY=
